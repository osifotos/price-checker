{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mtosin123/tf-price_checker/schema/diff.schema.json",
  "title": "price-checker diff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "currency", "period", "changes",
    "total_prior_monthly", "total_new_monthly", "total_delta_monthly",
    "total_delta_hourly", "summary", "metadata"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "currency": { "type": "string" },
    "period": { "enum": ["month", "hour"] },
    "total_prior_monthly": { "$ref": "#/$defs/decimal" },
    "total_new_monthly": { "$ref": "#/$defs/decimal" },
    "total_delta_monthly": { "$ref": "#/$defs/decimal" },
    "total_delta_hourly": { "$ref": "#/$defs/decimal" },
    "changes": { "type": "array", "items": { "$ref": "#/$defs/delta" } },
    "summary": { "$ref": "#/$defs/summary" },
    "metadata": { "$ref": "#/$defs/metadata" }
  },
  "$defs": {
    "decimal": { "type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$" },
    "delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "type", "kind", "prior_monthly", "new_monthly", "delta_monthly", "delta_hourly", "not_estimated"],
      "properties": {
        "address": { "type": "string" },
        "type": { "type": "string" },
        "kind": { "enum": ["added", "removed", "changed", "unchanged"] },
        "prior_monthly": { "$ref": "#/$defs/decimal" },
        "new_monthly": { "$ref": "#/$defs/decimal" },
        "delta_monthly": { "$ref": "#/$defs/decimal" },
        "delta_hourly": { "$ref": "#/$defs/decimal" },
        "not_estimated": { "type": "boolean" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resources_total", "resources_estimated", "resources_not_estimated", "components_estimated", "components_not_estimated"],
      "properties": {
        "resources_total": { "type": "integer", "minimum": 0 },
        "resources_estimated": { "type": "integer", "minimum": 0 },
        "resources_not_estimated": { "type": "integer", "minimum": 0 },
        "components_estimated": { "type": "integer", "minimum": 0 },
        "components_not_estimated": { "type": "integer", "minimum": 0 }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_version", "generated_at", "plan_format_version", "regions", "usage_file_used", "price_queries", "cache_hit_ratio", "dedup_hits"],
      "properties": {
        "tool_version": { "type": "string" },
        "generated_at": { "type": "string", "format": "date-time" },
        "plan_format_version": { "type": "string" },
        "regions": { "type": "array", "items": { "type": "string" } },
        "usage_file_used": { "type": "boolean" },
        "price_queries": { "type": "integer", "minimum": 0 },
        "cache_hit_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "dedup_hits": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
