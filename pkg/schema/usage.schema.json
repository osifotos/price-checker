{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mtosin123/tf-price_checker/schema/usage.schema.json",
  "title": "price-checker usage file",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "resource_usage"],
  "properties": {
    "version": { "type": "string" },
    "resource_usage": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "type": "number", "minimum": 0 }
      }
    }
  }
}
